COMPOSE_PROJECT_NAME=backend

# Genera contraseñas aleatorias antes de arrancar; no reutilices valores de ejemplo.
AUTH_DB_PASSWORD=
VOTING_DB_PASSWORD=
NOTIF_DB_PASSWORD=
RABBIT_USER=votacion
RABBIT_PASSWORD=
REPL_PASSWORD=
JWT_SECRET=

# Administrador inicial: Auth-Service lo crea (o promueve a ADMIN) al arrancar.
# Documento de 6 a 10 dígitos y contraseña de al menos 8 caracteres.
ADMIN_DOCUMENTO=
ADMIN_PASSWORD=
ADMIN_NOMBRE=Administrador
ADMIN_CORREO=admin@votacion.local

# El gateway queda accesible solo desde este PC por defecto.
# Para un teléfono físico, usa 0.0.0.0 y permite el puerto en el firewall.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8081
RABBITMQ_UI_PORT=15672