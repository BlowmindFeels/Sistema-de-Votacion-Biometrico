COMPOSE_PROJECT_NAME=backend

# Genera contraseñas aleatorias antes de arrancar; no reutilices valores de ejemplo.
AUTH_DB_PASSWORD=
VOTING_DB_PASSWORD=
NOTIF_DB_PASSWORD=
RABBIT_USER=votacion
RABBIT_PASSWORD=
REPL_PASSWORD=
JWT_SECRET=

# El gateway queda accesible solo desde este PC por defecto.
# Para un teléfono físico, usa 0.0.0.0 y permite el puerto en el firewall.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8081
RABBITMQ_UI_PORT=15672